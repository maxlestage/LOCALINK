    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LOCALINK cherche les téléphones à proximité sur votre réseau pour leur envoyer vos fichiers en direct."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LOCALINK looks for phones nearby on your network to send them your files directly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LOCALINK busca teléfonos cercanos en tu red para enviarles tus archivos directamente."
          }
