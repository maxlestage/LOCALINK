    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LOCALINK utilise l'appareil photo pour scanner le QR code d'un autre téléphone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LOCALINK uses the camera to scan the QR code of another phone."
