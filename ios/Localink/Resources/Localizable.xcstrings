    "Le fichier part sur le serveur LOCALINK. Vous obtenez un code et un QR code : votre contact a 2 minutes pour le récupérer, puis tout s'efface.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file goes to the LOCALINK server. You get a code and a QR code: your contact has 2 minutes to get it, then everything is erased."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo va al servidor de LOCALINK. Obtienes un código y un código QR: tu contacto tiene 2 minutos para recogerlo y luego todo se borra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier part sur le serveur LOCALINK. Vous obtenez un code et un QR code : votre contact a 2 minutes pour le récupérer, puis tout s'efface."
          }
        }
      }
    },
    "Le scanner n'est pas disponible : autorisez l'appareil photo dans Réglages, ou tapez le code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scanner isn't available: allow the camera in Settings, or type the code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escáner no está disponible: permite la cámara en Ajustes, o teclea el código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scanner n'est pas disponible : autorisez l'appareil photo dans Réglages, ou tapez le code."
          }
        }
