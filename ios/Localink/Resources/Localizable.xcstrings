            "value": "Ningún archivo recibido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun fichier reçu"
          }
        }
      }
    },
    "Aucun téléphone avec ce code à proximité. Vérifiez le code et que l'autre téléphone est sur l'écran Recevoir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No phone with this code nearby. Check the code, and that the other phone is on the Receive screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún teléfono cercano con este código. Comprueba el código y que el otro teléfono esté en la pantalla Recibir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun téléphone avec ce code à proximité. Vérifiez le code et que l'autre téléphone est sur l'écran Recevoir."
          }
        }
      }
    },
    "Ce code ne mène à aucun partage, ou ses 2 minutes sont passées.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code leads to no share, or its 2 minutes are over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código no lleva a nada, o sus 2 minutos ya pasaron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code ne mène à aucun partage, ou ses 2 minutes sont passées."
          }
        }
      }
    },
