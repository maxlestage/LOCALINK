    "Donnez ce code ou ce QR code : il fonctionne 2 minutes, puis le fichier est effacé du serveur.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give this code or this QR code: it works for 2 minutes, then the file is erased from the server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da este código o este código QR: funciona 2 minutos y luego el archivo se borra del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez ce code ou ce QR code : il fonctionne 2 minutes, puis le fichier est effacé du serveur."
          }
        }
      }
    },
